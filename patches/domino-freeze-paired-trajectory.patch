+++ b/script/eval_policy.py
@@
 import time
+import pickle
@@
     if st_seed < 0:
         raise ValueError(f"start_seed must be non-negative, got {st_seed}")
+    snapshot_path = os.environ.get("SMP_TRAJECTORY_SNAPSHOT")
